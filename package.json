{
  "name": "deep-sea-crew",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Deep Sea Crew - a cooperative trick-taking card game for mobile (LAN multiplayer)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p client/tsconfig.json",
    "dev:server": "npm run dev -w @dsc/server",
    "dev:client": "npm run dev -w @dsc/client",
    "build:client": "npm run build -w @dsc/client",
    "play": "npm run build:client && npm start -w @dsc/server",
    "train-bots": "npm run train -w @dsc/server",
    "bot-report": "npm run report -w @dsc/server",
    "win-report": "npm run winreport -w @dsc/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
